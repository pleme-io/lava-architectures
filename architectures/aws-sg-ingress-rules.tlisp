;; aws-sg-ingress-rules.tlisp — ingress rules added to a security group
;; this workspace does NOT own.
;;
;; ── ★ WHY THIS ARCHITECTURE HOLDS NO VALUES ───────────────────────────
;; It was derived from a real private workspace whose rendered
;; terraform.json is the parity oracle. That oracle carries a live AWS
;; security-group id and an operator's home CIDR, and this repo is
;; PUBLIC. So every such value is an :input — the structure ships here,
;; the values stay in the private repo that supplies them.
;;
;; This is not incidental tidiness. A parity architecture is exactly the
;; artifact most likely to be written by copying its oracle, and the
;; oracle is the thing that must not travel.
;;
;; ── ★ THE SHAPE IT ENCODES ────────────────────────────────────────────
;; "Adopt a group you don't own, then add rules to it" is a distinct and
;; recurring posture: the group's lifecycle belongs elsewhere, so the id
;; is an input rather than a (ref …), and destroying this workspace must
;; not destroy the group. Modelling it as a ref would silently claim
;; ownership — the rules would still apply, and a later destroy would
;; take the group with it.

;; ── ★ PORTS ARE LITERALS, NOT INPUTS — and that is a LIMIT, not a taste ──
;; A number written bare in this file (`22`) parses to Atom::Int and renders
;; as JSON `22`, which is what terraform's own schema expects and what the
;; parity oracle emits. A number arriving through an :input CANNOT do that:
;; InputBindings carries `set_str` and `set_list` and nothing else, so
;; `"{api-port}"` interpolates to the STRING "6443" no matter what is bound.
;;
;; So a parameterised port silently changes the rendered type. Terraform
;; accepts both and applies identically, which is exactly why this is worth
;; a comment rather than a bug report — it breaks byte-parity while breaking
;; nothing an operator would ever notice.
;;
;; The destination is a numeric binding on InputBindings; until then, a port
;; that must be a number is a literal here.

(deflava-interface aws-sg-ingress-rules
  :doc "Ingress rules attached to a pre-existing, externally-owned security group"
  :inputs ((:name :type :string :required #t)
    (:security-group-id :type :string :required #t)
    (:operator-cidrs :type (:list-of :string) :required #t)
    (:ssh-description :type :string :required #t)
    (:api-description :type :string :required #t))
  :outputs ((:security-group-id :type :string :required #t)
    (:cidr-count :type :string)))

(deflava-architecture aws-sg-ingress-rules
  :inputs ((:name "origin-sg")
    (:security-group-id "sg-placeholder")
    (:operator-cidrs ("203.0.113.0/32"))
    (:ssh-description "operator workstation — SSH")
    (:api-description "operator workstation — K3s API"))

  :resources ((aws-security-group-rule
     "{name}-ingress-ssh-0"
     :type
     "ingress"
     :from-port
     22
     :to-port
     22
     :protocol
     "tcp"
     :cidr-blocks
     "{operator-cidrs}"
     :security-group-id
     "{security-group-id}"
     :description
     "{ssh-description}")

    (aws-security-group-rule
      "{name}-ingress-api-0"
      :type
      "ingress"
      :from-port
      6443
      :to-port
      6443
      :protocol
      "tcp"
      :cidr-blocks
      "{operator-cidrs}"
      :security-group-id
      "{security-group-id}"
      :description
      "{api-description}"))

  ;; ★ :outputs, NOT :result — they are different clauses and only one of
  ;; them reaches terraform. `:result` is for downstream consumers composing
  ;; this architecture (lava-eval/src/eval.rs:154 skips it deliberately);
  ;; `:outputs` is what populates Architecture.outputs and renders as a
  ;; terraform `output` block. An architecture carrying only `:result` emits
  ;; no outputs at all, and nothing complains.
  :outputs (:k3s_origin_sg_id "{security-group-id}"
    :operator_cidr_count 1)

  :result (sg-ingress-rules
    :security-group-id "{security-group-id}"
    :cidr-count "1"))
