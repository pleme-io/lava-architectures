;; akeyless-secrets.tlisp — direct port of
;; pangea-architectures/lib/pangea/architectures/akeyless_secrets.rb
;;
;; Complete Akeyless secrets management architecture:
;;   API-key auth method for CI/CD pipelines
;;   K8s auth method for pod-based access
;;   Static secrets (database password, API key)
;;   DB target for dynamic-secret generation
;;   Application role for least-privilege access
;;
;; Synthesized to terraform.json compatible with magma + the
;; akeyless-community/akeyless terraform provider. Pair the
;; deflava-interface with eval_architecture_with_schema to type-check
;; inputs before any resource is constructed.

(deflava-interface akeyless-secrets
  :doc "Akeyless secrets management: auth methods + static secrets + DB target + role."
  :inputs ((:name-prefix :type :string :required #t)
    (:ci-ip :type :cidr-block :default "10.0.0.0/8")
    (:k8s-namespace :type :string :default "default")
    (:db-host :type :hostname :default "db.example.com")
    (:db-port :type :string :default "5432")
    (:db-name :type :string :default "production")
    (:db-admin-user :type :string :default "admin")
    (:db-admin-password :type :string :default "admin-password")
    (:db-password :type :string :default "change-me")
    (:api-key :type :string :default "change-me"))
  :outputs ((:ci-auth-id :type :string)
    (:k8s-auth-id :type :string)
    (:db-target-id :type :string)
    (:app-role-id :type :string)))

(deflava-architecture akeyless-secrets
  :inputs ((:name-prefix "prod")
    (:ci-ip "10.0.0.0/8")
    (:k8s-namespace "default")
    (:db-host "db.example.com")
    (:db-port "5432")
    (:db-name "production")
    (:db-admin-user "admin")
    (:db-admin-password "admin-password")
    (:db-password "change-me")
    (:api-key "change-me"))

  :resources ((akeyless-auth-method-api-key
     "{name-prefix}-ci-auth"
     :name
     "/{name-prefix}/ci-auth"
     :bound-ips
     ("{ci-ip}"))

    (akeyless-auth-method-k8s
      "{name-prefix}-k8s-auth"
      :name
      "/{name-prefix}/k8s-auth"
      :bound-namespaces
      ("{k8s-namespace}"))

    ;; Static secrets.
    (akeyless-static-secret
      "{name-prefix}-db-password"
      :name
      "/{name-prefix}/database/password"
      :value
      "{db-password}"
      :description
      "Primary database password")

    (akeyless-static-secret
      "{name-prefix}-api-key"
      :name
      "/{name-prefix}/service/api-key"
      :value
      "{api-key}"
      :description
      "External service API key")

    ;; Database target for dynamic secret generation.
    (akeyless-target-db
      "{name-prefix}-db-target"
      :name
      "/{name-prefix}/targets/postgres"
      :db-type
      "postgres"
      :connection-type
      "regular"
      :host
      "{db-host}"
      :port
      "{db-port}"
      :db-name
      "{db-name}"
      :user-name
      "{db-admin-user}"
      :pwd
      "{db-admin-password}")

    ;; Application role with access control.
    (akeyless-role
      "{name-prefix}-app-role"
      :name
      "/{name-prefix}/roles/app"
      :description
      "Application role for {name-prefix} environment"))

  :result (akeyless-secrets
    :ci-auth-id (ref akeyless-auth-method-api-key "{name-prefix}-ci-auth" id)
    :k8s-auth-id (ref akeyless-auth-method-k8s "{name-prefix}-k8s-auth" id)
    :db-target-id (ref akeyless-target-db "{name-prefix}-db-target" id)
    :app-role-id (ref akeyless-role "{name-prefix}-app-role" id)))
