;; pleme-io-server.tlisp — the pleme-io Discord server, declared.
;;
;; Renders to magma-compatible terraform.json against the Lucky3028/discord
;; provider, whose typed shapes live in lava-discord (generated by lava-forge
;; from a schema magma read out of the provider binary itself).
;;
;; ── THE SERVER IS CREATED, NOT ADOPTED ────────────────────────────────
;;
;; The root is `discord-server`, whose server-id is COMPUTED — this
;; declaration brings the guild into being. The consequence is permanent and
;; was accepted knowingly: the bot owns the guild, Discord only permits
;; bot-created guilds while the bot is in fewer than 10, and no API can hand
;; ownership to a human. If the server must ever be human-owned, a person
;; creates it and the root becomes `discord-managed-server` with a required
;; server-id — everything below this line is unchanged by that swap, which is
;; what makes it a cheap reversal rather than a rewrite.
;;
;; ── PERMISSION BITFIELDS ARE LITERAL, AND THAT IS A DSL LIMIT ─────────
;;
;; Discord permissions are a 64-bit field. The provider ships a
;; `discord_permission` DATA SOURCE that composes one from named booleans —
;; the right way to express this — but lava-forge emits resources only, so it
;; has no typed surface (tracked as G2).
;;
;; The intended interim was a named vocabulary in :inputs. That does not work
;; either: a NUMERIC value in an architecture's :inputs fails evaluation with
;; `type mismatch: expected string | list`. Measured, not assumed — inputs
;; accept strings and lists, nothing else. A literal integer AT A RESOURCE
;; SITE renders correctly as a JSON number, so that is what is used.
;;
;; Every constant below is therefore written where it is used, with its
;; derivation named. `pleme_io_server_permission_bits_are_correct` in
;; tests/architecture_matrix.rs pins each value, so a mistyped bit is a failed
;; test rather than a channel that is silently world-readable.
;;
;;   VIEW_CHANNEL           1 << 10 =           1024
;;   READ_MESSAGE_HISTORY   1 << 16 =          65536
;;   SEND_MESSAGES          1 << 11 =           2048
;;   ADD_REACTIONS          1 <<  6 =             64
;;   EMBED_LINKS            1 << 14 =          16384
;;   ATTACH_FILES           1 << 15 =          32768
;;   MANAGE_MESSAGES        1 << 13 =           8192
;;   CONNECT                1 << 20 =        1048576
;;   SPEAK                  1 << 21 =        2097152
;;   ADMINISTRATOR          1 <<  3 =              8
;;
;; Composed, and used by name in the comments at each site:
;;   READ_ONLY    = VIEW_CHANNEL + READ_MESSAGE_HISTORY                = 66560
;;   PARTICIPATE  = READ_ONLY + SEND_MESSAGES + ADD_REACTIONS
;;                            + EMBED_LINKS + ATTACH_FILES            = 117824
;;   MODERATE     = PARTICIPATE + MANAGE_MESSAGES                     = 126016
;;   VOICE        = VIEW_CHANNEL + CONNECT + SPEAK                   = 3146752
;;
;; ── WHAT THIS DOES NOT COVER ──────────────────────────────────────────
;;
;; The provider has no resource for automod, emojis, scheduled events,
;; threads, stage channels, slash commands, bans, or the welcome screen, so
;; none of them are declared here. "Everything the provider can express" is
;; strictly smaller than "everything in Discord" and this file does not imply
;; otherwise.
;;
;; Of the provider's 19 resources this uses 13. The six it does not, each with
;; its reason, so "unused" never has to be read as "forgotten":
;;
;;   discord-managed-server        mutually exclusive with discord-server —
;;                                 it is the OTHER root, not a missing piece
;;   discord-message               deliberate: making chat messages stateful
;;                                 infrastructure means they drift the moment
;;                                 somebody edits one
;;   discord-member-roles          needs a user id; membership is not server
;;                                 structure and does not belong in this file
;;   discord-role-connection-metadata  for linked-role verification, which
;;                                 needs an external OAuth app to be useful
;;   discord-guild-sticker         needs an image file; no asset pipeline here
;;   discord-server-onboarding     BLOCKED, not declined — see the waiver at
;;                                 the end of :resources for the measured cause

(deflava-interface pleme-io-server
  :doc "The pleme-io Discord server: roles, categories, channels, and the permission overwrites that decide who sees what."
  :inputs ((:name :type :string :default "pleme-io")
    (:description :type :string :default "pleme-io — substrate, languages, platform, products.")
    (:substrate-channels :type (:list-of :string :min-items 1))
    (:languages-channels :type (:list-of :string :min-items 1))
    (:platform-channels :type (:list-of :string :min-items 1))
    (:products-channels :type (:list-of :string :min-items 1))
    (:ops-channels :type (:list-of :string :min-items 1))
    (:voice-channels :type (:list-of :string :min-items 1)))
  :outputs ((:server-id :type :string)
    (:role-ids :type (:list-of :string))
    (:category-ids :type (:list-of :string))))

(deflava-architecture pleme-io-server
  :inputs ((:name "pleme-io")
    (:description "pleme-io — substrate, languages, platform, products.")
    (:substrate-channels ("magma" "lava" "sui" "nix"))
    (:languages-channels ("tatara-lisp" "blue"))
    (:platform-channels ("blackmatter" "camelot" "k8s"))
    (:products-channels ("mado" "hiroba" "gpu-apps"))
    (:ops-channels ("alerts" "releases"))
    (:voice-channels ("general" "pairing")))

  :resources (
    ;; ── the guild itself ────────────────────────────────────────────
    (discord-server
      "{name}"
      :name
      "{name}"
      :description
      "{description}"
      ;; 2 = members must have a verified email; the middle setting, and the
      ;; one that keeps drive-by spam out without gating on phone numbers.
      :explicit-content-filter
      2
      ;; 1 = only @mentions notify, so a busy #magma does not page everyone.
      :default-message-notifications
      1)

    ;; ── roles ───────────────────────────────────────────────────────
    ;; Position is REVERSE indexed: higher number is higher in the list and
    ;; wins on conflict. founder sits above maintainer above contributor.
    (discord-role
      "founder"
      :server-id
      (ref discord-server "{name}" id)
      :name
      "founder"
      :permissions
      8 ;; ADMINISTRATOR
      :hoist
      #t
      :mentionable
      #t
      :position
      4)
    (discord-role
      "maintainer"
      :server-id
      (ref discord-server "{name}" id)
      :name
      "maintainer"
      :permissions
      126016 ;; MODERATE
      :hoist
      #t
      :mentionable
      #t
      :position
      3)
    (discord-role
      "contributor"
      :server-id
      (ref discord-server "{name}" id)
      :name
      "contributor"
      :permissions
      117824 ;; PARTICIPATE
      :hoist
      #f
      :mentionable
      #t
      :position
      2)
    (discord-role
      "bot"
      :server-id
      (ref discord-server "{name}" id)
      :name
      "bot"
      :permissions
      117824 ;; PARTICIPATE — bots post, they do not moderate
      :hoist
      #f
      :mentionable
      #f
      :position
      1)

    ;; @everyone cannot be created, only managed. 0 = no server-wide grant at
    ;; all, so visibility is decided per channel by the overwrites below
    ;; rather than inherited by default. This is the line that makes "who can
    ;; see what" reviewable instead of emergent.
    (discord-role-everyone
      "everyone"
      :server-id
      (ref discord-server "{name}" id)
      :permissions
      0)

    ;; ── categories ──────────────────────────────────────────────────
    (discord-category-channel
      "substrate"
      :server-id
      (ref discord-server "{name}" id)
      :name
      "substrate"
      :position
      0)
    (discord-category-channel
      "languages"
      :server-id
      (ref discord-server "{name}" id)
      :name
      "languages"
      :position
      1)
    (discord-category-channel
      "platform"
      :server-id
      (ref discord-server "{name}" id)
      :name
      "platform"
      :position
      2)
    (discord-category-channel
      "products"
      :server-id
      (ref discord-server "{name}" id)
      :name
      "products"
      :position
      3)
    (discord-category-channel
      "theory"
      :server-id
      (ref discord-server "{name}" id)
      :name
      "theory"
      :position
      4)
    (discord-category-channel
      "ops"
      :server-id
      (ref discord-server "{name}" id)
      :name
      "ops"
      :position
      5)
    (discord-category-channel
      "voice"
      :server-id
      (ref discord-server "{name}" id)
      :name
      "voice"
      :position
      6)

    ;; ── the public front door ───────────────────────────────────────
    ;; The one channel @everyone can see, and the reason the baseline above
    ;; can safely be 0.
    (discord-text-channel
      "welcome"
      :server-id
      (ref discord-server "{name}" id)
      :name
      "welcome"
      :topic
      "Start here."
      :position
      0
      :nsfw
      #f)
    (discord-channel-permission
      "welcome-everyone"
      :channel-id
      (ref discord-text-channel "welcome" id)
      :overwrite-id
      (ref discord-role-everyone "everyone" id)
      :type
      "role"
      :allow
      66560 ;; READ_ONLY — anyone may read the front door, nobody may post in it
      :deny
      0)

    ;; ── channels, one per category, from the typed lists ────────────
    (for-each
      ((i ch) (enumerate substrate-channels))
      (discord-text-channel
        "substrate-{ch}"
        :server-id
        (ref discord-server "{name}" id)
        :name
        "{ch}"
        :category
        (ref discord-category-channel "substrate" id)
        :nsfw
        #f))
    (for-each
      ((i ch) (enumerate languages-channels))
      (discord-text-channel
        "languages-{ch}"
        :server-id
        (ref discord-server "{name}" id)
        :name
        "{ch}"
        :category
        (ref discord-category-channel "languages" id)
        :nsfw
        #f))
    (for-each
      ((i ch) (enumerate platform-channels))
      (discord-text-channel
        "platform-{ch}"
        :server-id
        (ref discord-server "{name}" id)
        :name
        "{ch}"
        :category
        (ref discord-category-channel "platform" id)
        :nsfw
        #f))
    (for-each
      ((i ch) (enumerate products-channels))
      (discord-text-channel
        "products-{ch}"
        :server-id
        (ref discord-server "{name}" id)
        :name
        "{ch}"
        :category
        (ref discord-category-channel "products" id)
        :nsfw
        #f))

    ;; theory is a FORUM channel — long-form, threaded, which is what theory
    ;; discussion actually is. A text channel would bury it.
    (discord-forum-channel
      "theory-forum"
      :server-id
      (ref discord-server "{name}" id)
      :name
      "theory"
      :category
      (ref discord-category-channel "theory" id)
      :topic
      "Long-form: THEORY.md, CSE, the loop.")

    ;; #releases is a NEWS channel so other servers can follow it; #alerts is
    ;; an ordinary text channel that the webhook below targets.
    (discord-news-channel
      "ops-releases"
      :server-id
      (ref discord-server "{name}" id)
      :name
      "releases"
      :category
      (ref discord-category-channel "ops" id)
      :topic
      "Auto-release output.")
    (discord-text-channel
      "ops-alerts"
      :server-id
      (ref discord-server "{name}" id)
      :name
      "alerts"
      :category
      (ref discord-category-channel "ops" id)
      :topic
      "Alertmanager, CI, and breathe."
      :nsfw
      #f)

    (for-each
      ((i vc) (enumerate voice-channels))
      (discord-voice-channel
        "voice-{vc}"
        :server-id
        (ref discord-server "{name}" id)
        :name
        "{vc}"
        :category
        (ref discord-category-channel "voice" id)))

    ;; ── permission overwrites ───────────────────────────────────────
    ;; One per category, granting contributor the right to participate. With
    ;; the @everyone baseline at 0, a category without an overwrite here is
    ;; invisible to everyone below founder — which is the safe direction to
    ;; fail, and is asserted by the matrix.
    (discord-channel-permission
      "substrate-contributor"
      :channel-id
      (ref discord-category-channel "substrate" id)
      :overwrite-id
      (ref discord-role "contributor" id)
      :type
      "role"
      :allow
      117824 ;; PARTICIPATE
      :deny
      0)
    (discord-channel-permission
      "languages-contributor"
      :channel-id
      (ref discord-category-channel "languages" id)
      :overwrite-id
      (ref discord-role "contributor" id)
      :type
      "role"
      :allow
      117824 ;; PARTICIPATE
      :deny
      0)
    (discord-channel-permission
      "platform-contributor"
      :channel-id
      (ref discord-category-channel "platform" id)
      :overwrite-id
      (ref discord-role "contributor" id)
      :type
      "role"
      :allow
      117824 ;; PARTICIPATE
      :deny
      0)
    (discord-channel-permission
      "products-contributor"
      :channel-id
      (ref discord-category-channel "products" id)
      :overwrite-id
      (ref discord-role "contributor" id)
      :type
      "role"
      :allow
      117824 ;; PARTICIPATE
      :deny
      0)
    (discord-channel-permission
      "theory-contributor"
      :channel-id
      (ref discord-category-channel "theory" id)
      :overwrite-id
      (ref discord-role "contributor" id)
      :type
      "role"
      :allow
      117824 ;; PARTICIPATE
      :deny
      0)
    ;; ops is read-only for contributors — CI writes here, humans do not.
    (discord-channel-permission
      "ops-contributor"
      :channel-id
      (ref discord-category-channel "ops" id)
      :overwrite-id
      (ref discord-role "contributor" id)
      :type
      "role"
      :allow
      66560 ;; READ_ONLY
      :deny
      2048) ;; SEND_MESSAGES explicitly denied, not merely ungranted
    (discord-channel-permission
      "voice-contributor"
      :channel-id
      (ref discord-category-channel "voice" id)
      :overwrite-id
      (ref discord-role "contributor" id)
      :type
      "role"
      :allow
      3146752 ;; VOICE
      :deny
      0)
    ;; the bot writes to ops and nowhere else
    (discord-channel-permission
      "ops-bot"
      :channel-id
      (ref discord-category-channel "ops" id)
      :overwrite-id
      (ref discord-role "bot" id)
      :type
      "role"
      :allow
      117824 ;; PARTICIPATE
      :deny
      0)

    ;; ── the rest of what the provider can express ───────────────────
    (discord-system-channel
      "system"
      :server-id
      (ref discord-server "{name}" id)
      :system-channel-id
      (ref discord-text-channel "welcome" id))
    (discord-server-widget
      "widget"
      :server-id
      (ref discord-server "{name}" id)
      :enable
      #t
      :channel-id
      (ref discord-text-channel "welcome" id))
    (discord-webhook
      "alerts-webhook"
      :channel-id
      (ref discord-text-channel "ops-alerts" id)
      :name
      "pleme-io-alerts")
    (discord-invite
      "welcome-invite"
      :channel-id
      (ref discord-text-channel "welcome" id)
      ;; 0 = never expires; an invite that dies is an invite that pages
      ;; somebody to regenerate it.
      :max-age
      0)
    ;; ── onboarding: WAIVED, and not for the reason it looks like ────
    ;;
    ;; `discord-server-onboarding` is the one provider resource this
    ;; declaration does not use. Its `default-channel-ids` is a REQUIRED list
    ;; of channel ids, and every channel id here is computed, so the value has
    ;; to be a list containing a `ref`.
    ;;
    ;; Measured, three ways, so the waiver names the real cause:
    ;;   (list of literal strings)      renders fine
    ;;   (bare ref)                     renders fine — but as a string, which
    ;;                                  is the wrong shape for a list attr
    ;;   (list containing a ref)        `type mismatch: expected tag val str`
    ;;
    ;; That is NOT a missing capability. lava-eval 0.2.1 handles it — its
    ;; own source says arrays "recurse", names `((ref aws-nat-gateway …))` as
    ;; the case that motivated it, and refers to `Type("tag val str")` as the
    ;; error things raised BEFORE. The `lava` CLI simply pins lava-eval
    ;; 0.1.10, four minor versions back.
    ;;
    ;; Bumping it is a real migration, not a version edit: 0.2 moves
    ;; `Architecture` to `lava_core` and drops `Value::Json`, so `lava`'s own
    ;; cli.rs stops compiling. That belongs in its own change. Once it lands,
    ;; delete this comment and add the resource — nothing else here moves.
    )

  :result (server
    :server-id (ref discord-server "{name}" id)
    :role-ids ((ref discord-role "founder" id)
      (ref discord-role "maintainer" id)
      (ref discord-role "contributor" id)
      (ref discord-role "bot" id))
    :category-ids ((ref discord-category-channel "substrate" id)
      (ref discord-category-channel "languages" id)
      (ref discord-category-channel "platform" id)
      (ref discord-category-channel "products" id)
      (ref discord-category-channel "theory" id)
      (ref discord-category-channel "ops" id)
      (ref discord-category-channel "voice" id))))
