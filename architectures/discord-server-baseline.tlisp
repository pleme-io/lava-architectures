;; discord-server-baseline.tlisp — a typed Discord server baseline.
;;
;; Synthesized to terraform.json compatible with magma + the
;; Lucky3028/discord provider, whose typed shapes live in lava-discord
;; (generated by lava-forge from a schema magma extracted from the
;; provider binary itself).

(deflava-interface discord-server-baseline
  :doc "Baseline roles and channels for one Discord server."
  :inputs ((:server-id :type :string :required #t)
    (:name-prefix :type :string :default "")
    (:moderator-color :type :string :default "10181046")
    (:general-topic :type :string :default "General discussion."))
  :outputs ((:server-id :type :string)
    (:role-ids :type (:list-of :string))))

(deflava-architecture discord-server-baseline
  :inputs ((:server-id "111122223333444455")
    (:name-prefix "")
    (:moderator-color "10181046")
    (:general-topic "General discussion."))

  :resources ((discord-role
     "{name-prefix}moderator"
     :server-id
     "{server-id}"
     :name
     "moderator"
     :hoist
     #t
     :mentionable
     #t)
    (discord-category-channel
      "{name-prefix}general-category"
      :server-id
      "{server-id}"
      :name
      "general"
      :position
      0)
    (discord-text-channel
      "{name-prefix}general-text"
      :server-id
      "{server-id}"
      :name
      "general"
      :topic
      "{general-topic}"
      :nsfw
      #f)))
