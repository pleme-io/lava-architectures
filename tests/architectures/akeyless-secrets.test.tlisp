(deflava-test akeyless-secrets/default
  :architecture akeyless-secrets
  :bindings (:name-prefix "smoke")
  :assertions ((resource-exists akeyless-auth-method-api-key "smoke-ci-auth")
               (resource-exists akeyless-auth-method-k8s "smoke-k8s-auth")
               (resource-exists akeyless-static-secret "smoke-db-password")
               (resource-exists akeyless-static-secret "smoke-api-key")
               (resource-exists akeyless-target-db "smoke-db-target")
               (resource-exists akeyless-role "smoke-app-role")
               (resource-count akeyless-static-secret 2)
               (attribute-equals akeyless-target-db "smoke-db-target" :db-type "postgres")
               (ref-valid)))
