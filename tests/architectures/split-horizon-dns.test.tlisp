(deflava-test split-horizon-dns/default
  :architecture split-horizon-dns
  :bindings (:name "smoke" :domain "smoke.example.com" :vpc-id "vpc-1234")
  :assertions ((resource-exists aws-route53-zone "smoke-public")
               (resource-exists aws-route53-zone "smoke-private")
               (resource-exists aws-route53-record "smoke-public-apex")
               (resource-exists aws-route53-record "smoke-private-apex")
               (resource-count aws-route53-zone 2)
               (resource-count aws-route53-record 2)
               (attribute-equals aws-route53-zone "smoke-private" :vpc-id "vpc-1234")
               (ref-valid)))
